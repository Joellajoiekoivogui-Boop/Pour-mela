# ─── Supabase (obligatoire pour l'authentification et les données) ───────
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adresse publique du site (liens des e-mails de confirmation et de
# réinitialisation). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé « service_role » : UNIQUEMENT pour le script de données de démonstration
# (npm run seed:demo), jamais utilisée par l'application ni envoyée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Intelligence artificielle (facultatif) ───────────────────────────────
# Sans clé, l'assistant fonctionne en « mode sans IA » (modèles prédéfinis).
# AI_PROVIDER : anthropic | openai  (openai = toute API compatible OpenAI :
# OpenAI, Mistral, Groq, OpenRouter, Ollama…)
AI_PROVIDER=anthropic
AI_API_KEY=
# Modèle (ex. claude-opus-5-5 pour anthropic, gpt-4o-mini pour openai)
AI_MODEL=
# Uniquement pour AI_PROVIDER=openai : URL de base de l'API compatible
AI_BASE_URL=https://api.openai.com/v1
# Nombre maximal de requêtes IA par utilisateur et par 24 h
AI_DAILY_LIMIT=30
