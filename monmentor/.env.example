# Base de données : fichier local en développement, Turso (libSQL) en production.
DATABASE_URL=file:./data/monmentor.db
# DATABASE_AUTH_TOKEN=            # jeton Turso en production

# Adresse publique du site (liens partagés, images d'aperçu, QR codes).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mode démonstration : boutons « Jury, visiteur ? » sur la connexion et
# affichage du code SMS à l'écran. À mettre à false en production.
DEMO_MODE=true

# Secrets : tâches planifiées, signature du numéro vérifié, noms des salles de visio.
CRON_SECRET=change-moi
AUTH_SECRET=change-moi-aussi

# Optionnel : analyse du besoin par Claude. Sans clé, détection par mots-clés.
# ANTHROPIC_API_KEY=

# Optionnel : visio (instance Jitsi auto-hébergée ou JaaS). Par défaut meet.jit.si.
# VISIO_BASE_URL=https://meet.jit.si

# Optionnel : envoi des notifications. Sans réglage, elles sont écrites dans le journal.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=monmentor_notification
# WHATSAPP_TEMPLATE_LANG=fr
# SMS_WEBHOOK_URL=                # POST JSON { to, text } vers votre fournisseur SMS
# SMS_WEBHOOK_TOKEN=
# EMAIL_WEBHOOK_URL=              # POST JSON { to, subject, text }
