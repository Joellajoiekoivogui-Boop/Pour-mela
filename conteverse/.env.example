# ─── CONTEVERSE — variables d'environnement ───────────────────────────
# Copie ce fichier en .env.local puis remplis les valeurs.
# Sans ces variables, l'application fonctionne en MODE DÉMONSTRATION :
# progression enregistrée sur l'appareil, LUMO avec réponses prédéfinies.

# Supabase (Project Settings > API). L'URL et la clé "anon" sont publiques
# par conception : la sécurité repose sur les politiques RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role : NE JAMAIS l'exposer côté client ni la préfixer NEXT_PUBLIC_.
# Elle n'est utilisée que par les scripts d'administration côté serveur (optionnel).
SUPABASE_SERVICE_ROLE_KEY=

# Assistant LUMO (Claude, Anthropic). Lue uniquement côté serveur (/api/lumo).
ANTHROPIC_API_KEY=
# Modèle utilisé par LUMO (optionnel).
LUMO_MODEL=claude-opus-5-5

# URL publique du site (métadonnées, liens de confirmation e-mail).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
